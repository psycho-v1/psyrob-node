{
  "name": "psyrob",
  "version": "10.0.0",
  "description": "PSYROB: block-DAG (GHOSTDAG) network with Argon2d CPU mining, NGO governance, contracts and explorer",
  "type": "module",
  "private": true,
  "bin": {
    "psyrob-node": "node/bin/psyrob-node.js",
    "psyrob-miner": "miner/bin/psyrob-miner.js",
    "psyrob-wallet": "node/bin/psyrob-wallet.js"
  },
  "scripts": {
    "node": "node node/bin/psyrob-node.js",
    "miner": "node miner/bin/psyrob-miner.js",
    "test": "node --test --test-timeout=120000 \"common/test/*.test.js\" \"node/test/*.test.js\" \"miner/test/*.test.js\"",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "genesis": "node genesis/build.js",
    "genesis:check": "node genesis/check.js",
    "release": "node scripts/build-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
